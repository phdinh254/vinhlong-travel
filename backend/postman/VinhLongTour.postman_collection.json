{
  "info": {
    "name": "VinhLong Tour API",
    "description": "Bộ request kiểm thử backend VinhLong Tour. Mỗi giai đoạn thêm một thư mục mới.\nImport vào Postman: File → Import → chọn file này. Đổi biến `baseUrl` nếu backend không chạy ở cổng 8081.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081" }
  ],
  "item": [
    {
      "name": "Giai đoạn 0 - Khung dự án",
      "item": [
        {
          "name": "Health - backend đang chạy",
          "request": { "method": "GET", "url": "{{baseUrl}}/actuator/health" },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Trả 200', () => pm.response.to.have.status(200));",
              "pm.test('status = UP (đã kết nối CSDL)', () => pm.expect(pm.response.json().status).to.eql('UP'));"
            ]}
          }]
        },
        {
          "name": "OpenAPI - tài liệu API cho Swagger",
          "request": { "method": "GET", "url": "{{baseUrl}}/v3/api-docs" },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Trả 200', () => pm.response.to.have.status(200));",
              "pm.test('Có trường openapi', () => pm.expect(pm.response.json()).to.have.property('openapi'));"
            ]}
          }]
        },
        {
          "name": "Swagger UI - trang thử API",
          "request": { "method": "GET", "url": "{{baseUrl}}/swagger-ui/index.html" },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Trả 200', () => pm.response.to.have.status(200));",
              "pm.test('Là trang HTML', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/html'));"
            ]}
          }]
        },
        {
          "name": "Lỗi chung - đường dẫn không tồn tại",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/khong-ton-tai" },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Trả 404', () => pm.response.to.have.status(404));",
              "pm.test('Đúng dạng lỗi chung {code, message, fields}', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.code).to.eql('NOT_FOUND');",
              "  pm.expect(body).to.have.property('message');",
              "  pm.expect(body).to.have.property('fields');",
              "});"
            ]}
          }]
        },
        {
          "name": "Lỗi chung - sai phương thức HTTP",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/v3/api-docs" },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Trả 405', () => pm.response.to.have.status(405));",
              "pm.test('code = METHOD_NOT_ALLOWED', () => pm.expect(pm.response.json().code).to.eql('METHOD_NOT_ALLOWED'));"
            ]}
          }]
        }
      ]
    }
  ]
}
